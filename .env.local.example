# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > "새 비공개 키 생성"으로 받은
# JSON 파일에서 아래 세 값을 그대로 복사하세요.

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# private_key 값은 줄바꿈이 포함되어 있으니 큰따옴표로 감싸서 그대로 붙여넣으세요.
FIREBASE_PRIVATE_KEY=""

# (선택) 배포 후 도메인. 초대 링크를 올바르게 만들 때 쓰입니다.
# 예: NEXT_PUBLIC_SITE_URL=https://moim.vercel.app
NEXT_PUBLIC_SITE_URL=
